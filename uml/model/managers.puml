@startuml
skinparam classAttributeIconSize 0

package "Interfejs Użytkownika (UI)" {
    class ConsoleUI {
        - coordinator: Coordinator&
        + start(): void
        + displayMenu(): void
    }
}

package "Warstwa Logiki Biznesowej (BLL)" {

    class Coordinator {
        - courseManager: CourseManager
        - studentManager: StudentManager
        - instructorManager: InstructorManager
        - drivingSessionManager: DrivingSessionManager
        - vehicleManager: VehicleManager

        + calculateRevenue(): double
        + calculateTotalCourseCost(courseId: int): double
        + completeCourse(courseId: int): void
        + checkStudentCourseBalance(studentId: int): double
        + getTotalHoursForCourse(courseId: int): double
        + getStudentHours(studentId: int): double

        + getAvailableVehicles(category: Category, range: TimeRange): std::vector<std::shared_ptr<Vehicle>>
        + getAvailableInstructors(category: Category, range: TimeRange): std::vector<Instructor>

        + getStudentById(id: int): Student
        + getInstructorById(id: int): Instructor
        + getVehicleById(id: int): std::shared_ptr<Vehicle>
        + getCourseById(id: int): Course
        + getDrivingSessionById(id: int): DrivingSession
    }

    class CourseManager {
        - coursesRepo: IRepository<Course>&
        - archiveCoursesRepo: IRepository<Course>&
        + completeCourse(courseId: int): void
        + findCourses(predicate: const CoursePredicate&): std::vector<Course>
        + findArchiveCourses(predicate: const CoursePredicate&): std::vector<CoursePtr>
        + findAllCourses(): std::vector<Course>
        + findAllArchiveCourses(): std::vector<CoursePtr>
        + registerCourse(studentId: int, instructorId: int, category: Category): void
        + getCourseReport(): std::string
        + getArchiveCourseReport(): std::string
        + getCourseById(id: int): CoursePtr
        + getArchiveCourseById(id: int): CoursePtr
    }

    class StudentManager {
        - studentRepo: IRepository<Student>&
        - archiveStudentRepo: IRepository<Student>&
        + registerStudent(student: const Student&): void
        + unregisterStudent(studentId: int): void
        + findStudents(predicate: const StudentPredicate&): std::vector<Student>
        + findAllStudents(): std::vector<Student>
        + updateExamStatus(studentId: int): void
    }

    class InstructorManager {
        - instructorRepo: IRepository<Instructor>&
        - archiveInstructorRepo: IRepository<Instructor>&
        + registerInstructor(instructor: const Instructor&): void
        + unregisterInstructor(instructorId: int): void
        + findInstructor(predicate: const InstructorPredicate&): std::vector<Instructor>
        + findArchiveInstructor(predicate: const InstructorPredicate&): std::vector<Instructor>
        + findAllInstructors(): std::vector<InstructorPtr>
        + findAllArchiveInstructors(): std::vector<InstructorPtr>
        + assignToCategory(instructorId: int, category: Category): void
        + getInstructorReport(): std::string
        + getArchiveInstructorReport(): std::string
        + getInstructorById(id: int): InstructorPtr
        + getArchiveInstructorById(id: int): InstructorPtr
    }

    class DrivingSessionManager {
        - drivingSessionRepo: IRepository<DrivingSession>&
        - archiveDrivingSessionRepo: IRepository<DrivingSession>&
        + scheduleSession(studentId: int, instructorId: int, vehicleId: int, range: TimeRange, coordinator: Coordinator&): void
        + cancelSession(sessionId: int, coordinator: Coordinator&): void
        + findDrivingSession(predicate: const DrivingSessionPredicate&): std::vector<DrivingSession>
        + findAllDrivingSession(): std::vector<DrivingSession>
    }

   class VehicleManager {
       - vehicleRepo: IRepository<Vehicle>&
       + registerVehicle(vehicle: std::shared_ptr<Vehicle>): void
       + unregisterVehicle(vehicleId: int): void
       + findVehicles(predicate: const VehiclePredicate&): std::vector<std::shared_ptr<Vehicle>>
       + findAllVehicles(): std::vector<std::shared_ptr<Vehicle>>
   }
}

ConsoleUI "1" --> "1" Coordinator : uses >

Coordinator "1" --> "1" CourseManager
Coordinator "1" --> "1" StudentManager
Coordinator "1" --> "1" InstructorManager
Coordinator "1" --> "1" DrivingSessionManager
Coordinator "1" --> "1" VehicleManager

note bottom of CourseManager
  coursesRepo - przechowuje aktualne kursy, które jeszcze trwają
  archiveCoursesRepo - przechowuje ukończone kursy (archiwum)
  registerCourse - odpowiada za utworzenie nowego kursu w systemie
end note

note bottom of StudentManager
  studentRepo - przechowuje aktywnych kursantów szkoły
  archiveStudentRepo - przechowuje kursantów z zakończonym procesem szkolenia
  unregisterStudent - usuwa studenta, automatycznie odwołując jego jazdy
  updateExamStatus - weryfikuje warunki i zmienia status gotowości na egzamin
end note

note bottom of InstructorManager
  instructorRepo - baza aktywnych instruktorów
  archiveInstructorRepo - kadra przeniesiona do archiwum
  unregisterInstructor - usuwa instruktora i czyści jego nadchodzący grafik sesji
  assignToCategory - nadaje nowe uprawnienia szkoleniowe do profilu
end note

note bottom of DrivingSessionManager
  cancelSession - odwołuje wybraną jazdę i natychmiast zwalnia zasoby
end note

note bottom of VehicleManager
  registerVehicle - wprowadza nowy pojazd do floty szkoły jazdy
  unregisterVehicle - wycofuje pojazd (wymaga braku powiązanych sesji)
end note

@enduml