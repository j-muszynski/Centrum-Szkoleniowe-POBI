@startuml
skinparam classAttributeIconSize 0
class CourseManager {
    - coursesRepo: CourseRepository&
    - archiveCoursesRepo: CourseRepository&
    + findCourses(predicate: const CoursePredicate&): std::vector<Course>
    + findAllCourses(): std::vector<Course>
    + checkStudentCourseBalance(personalID: std::string): double
    + registerCourse(studentId: int, instructorId: int, category: Category): void
    + completeCourse(courseId: int): void
    + calculateRevenue(): double
}
note bottom of CourseManager
  coursesRepo CourseRepository& - przechowuje aktualne kursy,
     które jeszcze nie zostały ukończone
  archiveCoursesRepo CourseRepository& - przechowuje ukończoen kursy
  registerCourse - Tworzy kurs
  completeCourse - Czy wyjeżdżono godziny?
  calculateRevenue() - Podlicza zysk
end note

class StudentManager {
    - studentRepo: StudentRepository&
    - archiveStudentRepo: StudentRepository&
    + registerStudent(student: const Student&): void
    + unregisterStudent(studentId: int): void
    + findStudents(predicate: const StudentPredicate&): std::vector<Student>
    + findAllStudents(): std::vector<Student>
    + updateExamStatus(studentId: int): void
    + getStudentHours(studentId: int): double
}
note bottom of StudentManager
  studentRepo:StudentRepository& -  przechowuje
     kursantów, które jeszcze nie ukończyli kursu
  archiveStudentRepo StudentRepository& - przechowuje kursantów,
     którzy już ukończyli kurs
  registerStudent - Tworzy nowego studenta
  unregisterStudent - Usuwa studenta z listy, odwołuje wszystkie zaplanowane jazdy
  updateExamStatus - Czy można zmienić status gotowości na egzamin?
  getStudentHours - Sumuje wyjeżdżone godziny studenta
end note

class InstructorManager {
    - instructorRepo: InstructorRepository&
    - archiveInstructorRepo: InstructorRepository&
    + registerInstructor(instructor: const Instructor&): void
    + unregisterInstructor(instructorId: int): void
    + findInstructor(predicate: const InstructorPredicate&): std::vector<Instructor>
    + findAllInstructors(): std::vector<Instructor>
    + assignToCategory(instructorId: int, category: Category): void
    + getAvailableInstructors(category: Category): std::vector<Instructor>
}
note bottom of InstructorManager
  instructorRepo InstructorReposiotry& - przechowuje instruktorów
  registerInstructor - Tworzy nowego instruktora
  unregisterInstructor - Usuwua instruktora z listy, odwołuje jego
     zaplanowane jazdy
  assignToCategory - Nadaje prawo do uczenia danej kategorii
  getAvailableInstructors - zwraca listę instruktorów z uprawnieniami
end note


class DrivingSessionManager {
    - drivingSessionRepo: DrivingSessionRepository&
    - archiveDrivingSessionRepo: DrivingSessionRepository&
    + scheduleSession(studentId: int, instructorId: int, vehicleId: int, range: TimeRange): void
    + cancelSession(sessionId: int): void
    + findDrivingSession(predicate: const DrivingSessionPredicate&): std::vector<DrivingSession>
    + findAllDrivingSession(): std::vector<DrivingSession>
    + getTotalHoursForCourse(courseId: int): double
}
note bottom of DrivingSessionManager
  cancelSession - Odwołuje jazdę i zwalnia zasoby
  getTotalHoursForCourse - Zwraca liczbę godzin wyjeżdżonych dla
    danego kursu
end note
note right of DrivingSessionManager::scheduleSession
  Weryfikacja konfliktów:
  - Brak kolizji w grafiku instruktora
  - Dostępność pojazdu
  - Wolny termin kursanta
end note

class VehicleManager {
    - vehicleRepo: VehicleRepository&
    + registerVehicle(vehicle: std::shared_ptr<Vehicle>): void
    + unregisterVehicle(vehicleId: int): void
    + findVehicles(predicate: const VehiclePredicate&): std::vector<std::shared_ptr<Vehicle>>
    + findAllVehicles(): std::vector<std::shared_ptr<Vehicle>>
    + getAvailableVehicles(category: Category, range: TimeRange): std::vector<std::shared_ptr<Vehicle>>
}
note bottom of VehicleManager
  registerVehicle - Dodaje nowy pojazd do floty
  unregisterVehicle - Usuwa pojazd z systemu, sprawdza czy do
    pojazdu nie są przypisane jazdy
  findVehicles - Wyszukuje pojazdy spełniające kryteria
  findAllVehicles - Zwraca wszystkie pojazdy w centrum
  getAvailableVehicles - Zwraca listę pojazdów danej kategorii, które nie
    mają w danym czasie przypisanej żadnej sesji w DrivingSessionManager
end note

CourseManager ..> Course
CourseManager ..> CoursePredicate

StudentManager ..> Student
StudentManager ..> StudentPredicate

InstructorManager ..> Instructor
InstructorManager ..> InstructorPredicate

DrivingSessionManager ..> DrivingSession
DrivingSessionManager ..> DrivingSessionPredicate

VehicleManager ..> Vehicle
VehicleManager ..> VehiclePredicate

@enduml