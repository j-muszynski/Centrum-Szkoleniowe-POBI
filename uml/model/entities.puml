@startuml
skinparam classAttributeIconSize 0

package "Typy Wyliczeniowe (Enums)" {
    enum Category {
        AM
        A1
        A2
        A
        B
        BE
        C
        CE
        D
        DE
    }
}

package "Realizacja Kursów (Course Execution)" {
    class Course {
        - id: int
        - type: Category
        - instructor: Instructor*
        - student: Student*
        - isFinished: bool
    }

    class DrivingSession {
        - id: int
        - startTime: DateTime
        - endTime: DateTime
        - instructor: Instructor*
        - student: Student*
        - courseId: int
        - vehicle: Vehicle*
        - status: std::string
        + getSessionCost(): double
    }

    note right of DrivingSession
      getSessionCost() oblicza koszt na podstawie:
      pojazd.getBaseHourlyCost() × liczba godzin jazdy
    end note
}

Course .up.> Category : <<uses>>
DrivingSession .up.> Category : <<uses>>
@enduml