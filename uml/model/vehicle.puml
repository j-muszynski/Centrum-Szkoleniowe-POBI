@startuml
skinparam classAttributeIconSize 0

package "Typy Wyliczeniowe (Enums)" {
    enum Category <<enumeration>>
}

package "Pojazdy" {
    abstract class Vehicle {
        - id: int
        - plateNumber: std::string
        - category: Category
        + {abstract} getBaseHourlyCost(): double
    }

    class Motorcycle {
        - engineCapacity: int
        - power: double
        + getBaseHourlyCost(): double
    }
    note bottom of Motorcycle
      Konstruktor zawiera logikę przyznawania
      kategorii (AM, A1, A2, A) na podstawie mocy.
    end note

    abstract class HeavyVehicle {
        - grossVehicleWeight: double
        - hasTrailer: bool
        + {abstract} getBaseHourlyCost(): double
    }

    class PassengerCar {
        + getBaseHourlyCost(): double
    }

    class Truck {
        - cargoCapacity: double
        + getBaseHourlyCost(): double
    }
    note right of Truck
      Logika kategorii:
      hasTrailer == false -> Kat. C
      hasTrailer == true -> Kat. C+E
    end note

    class Bus {
        - numberOfSeats: int
        + getBaseHourlyCost(): double
    }
    note bottom of Bus
      Logika kategorii:
      hasTrailer == false -> Kat. D
      hasTrailer == true -> Kat. D+E
    end note
}

Vehicle <|-- Motorcycle
Vehicle <|-- HeavyVehicle
Vehicle <|-- PassengerCar
HeavyVehicle <|-- Truck
HeavyVehicle <|-- Bus

Vehicle .right.> Category : <<uses>>
@enduml