@startuml
skinparam classAttributeIconSize 0

package "Warstwa Składowania Danych (DAL)" {

    interface IRepository<T> {
        + save(data: std::vector<T>) : void
        + load() : std::vector<T>
        + findAll() : std::vector<T>
        + findBy(predicate: Predicate<T>) : std::vector<T>
        + add(item: T) : void
        + remove(id: int) : void
        + getById(id: int) : T
        + getSize() : int
    }

    abstract class AbstractFileRepository<T> {
        # filePath : std::string
    }

    IRepository <|.. AbstractFileRepository

    class CourseRepository {
        + reportCourses(): std::string
    }

    class DrivingSessionRepository {
        + reportDrivingSession(): std::string
    }

    class InstructorRepository {
        + reportInstructors(): std::string
    }

    class StudentRepository {
        + reportStudents(): std::string
    }

    class VehicleRepository {
        + reportVehicles(): std::string
    }

    AbstractFileRepository <|-- CourseRepository
    AbstractFileRepository <|-- DrivingSessionRepository
    AbstractFileRepository <|-- InstructorRepository
    AbstractFileRepository <|-- StudentRepository
    AbstractFileRepository <|-- VehicleRepository

    note "Klasy (np. CourseRepository, VehicleRepository itd.)\nw pełni implementują oraz nadpisują wszystkie metody\nczysto wirtualne zdefiniowane w interfejsie IRepository<T>\n(w tym operacje zapisu, odczytu oraz zarządzania kolekcją)." as DAL_Note
    AbstractFileRepository .. DAL_Note
}
@enduml